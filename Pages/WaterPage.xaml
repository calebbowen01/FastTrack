<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MyMauiApp.ViewModels"
             x:Class="MyMauiApp.Pages.WaterPage"
             x:DataType="vm:WaterViewModel"
             BackgroundColor="{StaticResource PageBackground}">

    <ScrollView>
        <VerticalStackLayout Padding="20,16,20,20" Spacing="16">

            <Label Text="Water Tracker"
                   FontSize="26" FontAttributes="Bold"
                   TextColor="{StaticResource White}" />

            <!-- Main Water Card -->
            <Frame BackgroundColor="{StaticResource CardBackground}"
                   CornerRadius="20" Padding="28" BorderColor="Transparent"
                   HasShadow="False">
                <VerticalStackLayout Spacing="14" HorizontalOptions="Center">
                    <Label Text="💧" FontSize="48" HorizontalOptions="Center" />

                    <Label Text="{Binding ProgressLiters}"
                           FontSize="28" FontAttributes="Bold"
                           TextColor="{StaticResource AccentCyan}"
                           HorizontalOptions="Center" />

                    <Label Text="{Binding PercentText}"
                           FontSize="18" TextColor="{StaticResource Gray300}"
                           HorizontalOptions="Center" />

                    <ProgressBar Progress="{Binding Progress}"
                                 ProgressColor="{StaticResource AccentCyan}"
                                 BackgroundColor="{StaticResource CardBackgroundAlt}"
                                 HeightRequest="10" Margin="0,4" />

                    <Label Text="{Binding GlassCount, StringFormat='{0} glasses (250ml each)'}"
                           FontSize="13" TextColor="{StaticResource Gray400}"
                           HorizontalOptions="Center" />

                    <Label Text="🎉 Daily goal reached!"
                           FontSize="15" TextColor="{StaticResource Accent}"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           IsVisible="{Binding GoalReached}" />
                </VerticalStackLayout>
            </Frame>

            <!-- Quick Add Buttons -->
            <Label Text="Quick Add" FontSize="17" FontAttributes="Bold"
                   TextColor="{StaticResource White}" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Text="+250 ml"
                        Command="{Binding Add250Command}"
                        BackgroundColor="{StaticResource AccentCyan}"
                        TextColor="{StaticResource Black}"
                        FontAttributes="Bold" FontSize="16"
                        CornerRadius="14" HeightRequest="52" />
                <Button Grid.Column="1" Text="+500 ml"
                        Command="{Binding Add500Command}"
                        BackgroundColor="{StaticResource AccentBlue}"
                        TextColor="{StaticResource White}"
                        FontAttributes="Bold" FontSize="16"
                        CornerRadius="14" HeightRequest="52" />
            </Grid>

            <!-- Custom Amount -->
            <Frame BackgroundColor="{StaticResource CardBackground}"
                   CornerRadius="14" Padding="16" BorderColor="Transparent" HasShadow="False">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <Entry Placeholder="Custom amount (ml)" Text="{Binding CustomAmount}"
                           Keyboard="Numeric"
                           PlaceholderColor="{StaticResource Gray500}"
                           TextColor="{StaticResource White}"
                           BackgroundColor="{StaticResource CardBackgroundAlt}" />
                    <Button Grid.Column="1" Text="Add"
                            Command="{Binding AddCustomCommand}"
                            BackgroundColor="{StaticResource Accent}"
                            TextColor="{StaticResource Black}"
                            FontAttributes="Bold" CornerRadius="10"
                            HeightRequest="44" WidthRequest="80" />
                </Grid>
            </Frame>

            <!-- Undo -->
            <Button Text="↩ Undo Last"
                    Command="{Binding UndoCommand}"
                    BackgroundColor="{StaticResource CardBackgroundAlt}"
                    TextColor="{StaticResource Gray300}"
                    FontSize="14" CornerRadius="12"
                    HeightRequest="44" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
