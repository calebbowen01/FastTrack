<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MyMauiApp.ViewModels"
             x:Class="MyMauiApp.Pages.ProfilePage"
             x:DataType="vm:ProfileViewModel"
             BackgroundColor="{StaticResource PageBackground}">

    <ScrollView>
        <VerticalStackLayout Padding="20,16,20,20" Spacing="16">

            <Label Text="Profile &amp; Settings"
                   FontSize="26" FontAttributes="Bold"
                   TextColor="{StaticResource White}" />

            <!-- Stats Overview -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                <Frame BackgroundColor="{StaticResource CardBackground}"
                       CornerRadius="16" Padding="14" BorderColor="Transparent" HasShadow="False">
                    <StackLayout Spacing="4" HorizontalOptions="Center">
                        <Label Text="🔥" FontSize="24" HorizontalOptions="Center" />
                        <Label Text="{Binding FastingStreak, StringFormat='{0}'}"
                               FontSize="24" FontAttributes="Bold"
                               TextColor="{StaticResource Accent}" HorizontalOptions="Center" />
                        <Label Text="Streak" FontSize="11"
                               TextColor="{StaticResource Gray400}" HorizontalOptions="Center" />
                    </StackLayout>
                </Frame>
                <Frame Grid.Column="1" BackgroundColor="{StaticResource CardBackground}"
                       CornerRadius="16" Padding="14" BorderColor="Transparent" HasShadow="False">
                    <StackLayout Spacing="4" HorizontalOptions="Center">
                        <Label Text="🏆" FontSize="24" HorizontalOptions="Center" />
                        <Label Text="{Binding LongestStreak, StringFormat='{0}'}"
                               FontSize="24" FontAttributes="Bold"
                               TextColor="{StaticResource AccentOrange}" HorizontalOptions="Center" />
                        <Label Text="Best" FontSize="11"
                               TextColor="{StaticResource Gray400}" HorizontalOptions="Center" />
                    </StackLayout>
                </Frame>
                <Frame Grid.Column="2" BackgroundColor="{StaticResource CardBackground}"
                       CornerRadius="16" Padding="14" BorderColor="Transparent" HasShadow="False">
                    <StackLayout Spacing="4" HorizontalOptions="Center">
                        <Label Text="✅" FontSize="24" HorizontalOptions="Center" />
                        <Label Text="{Binding TotalFasts, StringFormat='{0}'}"
                               FontSize="24" FontAttributes="Bold"
                               TextColor="{StaticResource AccentBlue}" HorizontalOptions="Center" />
                        <Label Text="Total" FontSize="11"
                               TextColor="{StaticResource Gray400}" HorizontalOptions="Center" />
                    </StackLayout>
                </Frame>
            </Grid>

            <!-- Calorie &amp; Water Goals -->
            <Label Text="Daily Goals" FontSize="17" FontAttributes="Bold"
                   TextColor="{StaticResource White}" Margin="0,8,0,0" />

            <Frame BackgroundColor="{StaticResource CardBackground}"
                   CornerRadius="16" Padding="20" BorderColor="Transparent" HasShadow="False">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <StackLayout Spacing="4">
                            <Label Text="Calorie Goal (kcal)" FontSize="13" TextColor="{StaticResource Gray300}" />
                            <Entry Text="{Binding CalorieGoalText}" Keyboard="Numeric"
                                   PlaceholderColor="{StaticResource Gray500}"
                                   TextColor="{StaticResource White}"
                                   BackgroundColor="{StaticResource CardBackgroundAlt}" />
                        </StackLayout>
                        <StackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Water Goal (ml)" FontSize="13" TextColor="{StaticResource Gray300}" />
                            <Entry Text="{Binding WaterGoalText}" Keyboard="Numeric"
                                   PlaceholderColor="{StaticResource Gray500}"
                                   TextColor="{StaticResource White}"
                                   BackgroundColor="{StaticResource CardBackgroundAlt}" />
                        </StackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Macro Goals -->
            <Label Text="Macro Goals" FontSize="17" FontAttributes="Bold"
                   TextColor="{StaticResource White}" />

            <Frame BackgroundColor="{StaticResource CardBackground}"
                   CornerRadius="16" Padding="20" BorderColor="Transparent" HasShadow="False">
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                    <StackLayout Spacing="4">
                        <Label Text="Protein (g)" FontSize="12" TextColor="{StaticResource AccentBlue}" />
                        <Entry Text="{Binding ProteinGoalText}" Keyboard="Numeric"
                               PlaceholderColor="{StaticResource Gray500}"
                               TextColor="{StaticResource AccentBlue}"
                               BackgroundColor="{StaticResource CardBackgroundAlt}" />
                    </StackLayout>
                    <StackLayout Grid.Column="1" Spacing="4">
                        <Label Text="Carbs (g)" FontSize="12" TextColor="{StaticResource AccentOrange}" />
                        <Entry Text="{Binding CarbsGoalText}" Keyboard="Numeric"
                               PlaceholderColor="{StaticResource Gray500}"
                               TextColor="{StaticResource AccentOrange}"
                               BackgroundColor="{StaticResource CardBackgroundAlt}" />
                    </StackLayout>
                    <StackLayout Grid.Column="2" Spacing="4">
                        <Label Text="Fat (g)" FontSize="12" TextColor="{StaticResource AccentRed}" />
                        <Entry Text="{Binding FatGoalText}" Keyboard="Numeric"
                               PlaceholderColor="{StaticResource Gray500}"
                               TextColor="{StaticResource AccentRed}"
                               BackgroundColor="{StaticResource CardBackgroundAlt}" />
                    </StackLayout>
                </Grid>
            </Frame>

            <!-- Body Stats -->
            <Label Text="Body Stats" FontSize="17" FontAttributes="Bold"
                   TextColor="{StaticResource White}" />

            <Frame BackgroundColor="{StaticResource CardBackground}"
                   CornerRadius="16" Padding="20" BorderColor="Transparent" HasShadow="False">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <StackLayout Spacing="4">
                            <Label Text="Current Weight (lbs)" FontSize="13" TextColor="{StaticResource Gray300}" />
                            <Entry Text="{Binding WeightText}" Keyboard="Numeric"
                                   PlaceholderColor="{StaticResource Gray500}"
                                   TextColor="{StaticResource White}"
                                   BackgroundColor="{StaticResource CardBackgroundAlt}" />
                        </StackLayout>
                        <StackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Goal Weight (lbs)" FontSize="13" TextColor="{StaticResource Gray300}" />
                            <Entry Text="{Binding GoalWeightText}" Keyboard="Numeric"
                                   PlaceholderColor="{StaticResource Gray500}"
                                   TextColor="{StaticResource White}"
                                   BackgroundColor="{StaticResource CardBackgroundAlt}" />
                        </StackLayout>
                    </Grid>
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                        <StackLayout Spacing="4">
                            <Label Text="Height (in)" FontSize="13" TextColor="{StaticResource Gray300}" />
                            <Entry Text="{Binding HeightText}" Keyboard="Numeric"
                                   Placeholder="e.g. 70"
                                   PlaceholderColor="{StaticResource Gray500}"
                                   TextColor="{StaticResource White}"
                                   BackgroundColor="{StaticResource CardBackgroundAlt}" />
                        </StackLayout>
                        <StackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Age" FontSize="13" TextColor="{StaticResource Gray300}" />
                            <Entry Text="{Binding AgeText}" Keyboard="Numeric"
                                   Placeholder="e.g. 25"
                                   PlaceholderColor="{StaticResource Gray500}"
                                   TextColor="{StaticResource White}"
                                   BackgroundColor="{StaticResource CardBackgroundAlt}" />
                        </StackLayout>
                        <StackLayout Grid.Column="2" Spacing="4">
                            <Label Text="Gender" FontSize="13" TextColor="{StaticResource Gray300}" />
                            <Picker ItemsSource="{Binding Genders}"
                                    SelectedItem="{Binding SelectedGender}"
                                    TextColor="{StaticResource White}"
                                    BackgroundColor="{StaticResource CardBackgroundAlt}" />
                        </StackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- BMR Calculator -->
            <Frame BackgroundColor="{StaticResource CardBackground}"
                   CornerRadius="16" Padding="20" BorderColor="Transparent" HasShadow="False">
                <VerticalStackLayout Spacing="10">
                    <Label Text="🔬 BMR / TDEE Calculator" FontSize="15" FontAttributes="Bold"
                           TextColor="{StaticResource White}" />
                    <Label Text="Fill in your body stats above, then tap Calculate to see your estimated daily calorie needs."
                           FontSize="12" TextColor="{StaticResource Gray400}" />
                    <Button Text="Calculate BMR"
                            Command="{Binding CalculateBmrCommand}"
                            BackgroundColor="{StaticResource AccentCyan}"
                            TextColor="{StaticResource Black}"
                            FontAttributes="Bold" FontSize="14"
                            CornerRadius="10" HeightRequest="42" />
                    <Label Text="{Binding BmrDisplay}"
                           FontSize="13" TextColor="{StaticResource AccentCyan}"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Frame>

            <!-- Notifications -->
            <Label Text="Notifications" FontSize="17" FontAttributes="Bold"
                   TextColor="{StaticResource White}" />

            <Frame BackgroundColor="{StaticResource CardBackground}"
                   CornerRadius="16" Padding="20" BorderColor="Transparent" HasShadow="False">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackLayout Spacing="2" VerticalOptions="Center">
                            <Label Text="🔔 Push Notifications" FontSize="14"
                                   TextColor="{StaticResource White}" />
                            <Label Text="Fasting complete, halfway alerts"
                                   FontSize="11" TextColor="{StaticResource Gray400}" />
                        </StackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding NotificationsEnabled}"
                                OnColor="{StaticResource Accent}"
                                ThumbColor="{StaticResource White}" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="{StaticResource CardBackgroundAlt}" />
                    <Grid ColumnDefinitions="*,Auto">
                        <StackLayout Spacing="2" VerticalOptions="Center">
                            <Label Text="💧 Water Reminders" FontSize="14"
                                   TextColor="{StaticResource White}" />
                            <Label Text="Remind every 2 hours (8 AM–10 PM)"
                                   FontSize="11" TextColor="{StaticResource Gray400}" />
                        </StackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding WaterRemindersEnabled}"
                                OnColor="{StaticResource AccentCyan}"
                                ThumbColor="{StaticResource White}" />
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Save Button -->
            <Button Text="Save All Settings"
                    Command="{Binding SaveCommand}"
                    BackgroundColor="{StaticResource Accent}"
                    TextColor="{StaticResource Black}"
                    FontAttributes="Bold" FontSize="16"
                    CornerRadius="12" HeightRequest="48" />

            <Label Text="{Binding StatusMessage}"
                   FontSize="13" TextColor="{StaticResource Accent}"
                   HorizontalOptions="Center" />

            <!-- Reset -->
            <Button Text="Reset All Data"
                    Command="{Binding ResetDataCommand}"
                    BackgroundColor="{StaticResource CardBackgroundAlt}"
                    TextColor="{StaticResource AccentRed}"
                    FontSize="14" CornerRadius="12"
                    HeightRequest="44"
                    Margin="0,10,0,0" />

            <Label Text="FastTrack v1.0 — Built with .NET MAUI"
                   FontSize="11" TextColor="{StaticResource Gray600}"
                   HorizontalOptions="Center" Margin="0,20,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
